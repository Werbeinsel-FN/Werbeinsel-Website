/*
 * Lokal gehostete Schriften – ersetzt die Einbindung von Google Fonts.
 * Solange diese Datei fonts.css.example heisst, laedt das Theme weiterhin
 * von Google. Nach dem Ablegen der .woff2-Dateien in diesem Ordner
 * einfach in fonts.css umbenennen.
 */

@font-face {
  font-family: 'Unbounded';
  font-style: normal;
  font-weight: 400;
  font-display: swap;
  src: url('./unbounded-400.woff2') format('woff2');
  unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC,
                 U+0100-024F, U+0259, U+1E00-1EFF, U+2000-206F, U+2074, U+20AC,
                 U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
}

@font-face {
  font-family: 'Unbounded';
  font-style: normal;
  font-weight: 700;
  font-display: swap;
  src: url('./unbounded-700.woff2') format('woff2');
  unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC,
                 U+0100-024F, U+0259, U+1E00-1EFF, U+2000-206F, U+2074, U+20AC,
                 U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
}

